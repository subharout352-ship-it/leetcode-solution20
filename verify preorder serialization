class Solution(object):
    def isValidSerialization(self, preorder):
        """
        :type preorder: str
        :rtype: bool
        """
        slots = 1

        for node in preorder.split(','):
            # No available position for this node
            if slots == 0:
                return False

            if node == '#':
                slots -= 1
            else:
                # Use one slot and create two child slots
                slots += 1

        return slots == 0
